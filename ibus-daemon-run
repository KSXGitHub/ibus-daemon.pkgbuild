#!/bin/sh
# Launch ibus-daemon, exposing a Wayland session address when one exists.
#
# ibus records its address per display server in ~/.config/ibus/bus/:
#   <machine-id>-unix-<DISPLAY>          for X11
#   <machine-id>-unix-<WAYLAND_DISPLAY>  for Wayland
# Hybrid sessions (WSLg, XWayland, nested compositors) have GUI clients that
# read the Wayland address, but ibus@.service only passes DISPLAY, so the
# daemon writes the X11 address alone and native Wayland clients cannot reach
# it. Detect the compositor socket instead of hardcoding wayland-0 so that
# pure X11 sessions behave exactly as before.

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
	for socket in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
		if [ -S "$socket" ]; then
			WAYLAND_DISPLAY=${socket##*/}
			export WAYLAND_DISPLAY
			break
		fi
	done
fi

exec /usr/bin/ibus-daemon "$@"
